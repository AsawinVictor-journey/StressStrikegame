# Copy to .env and fill in. .env is gitignored - never commit a real connection string or API key.

# --- Gemini: required for AI copy. ---
# Get a key at https://aistudio.google.com/apikey. Powers /api/gemini/generate,
# used by the Unity client's GeminiClient for check-in mode picks and Coach Byte copy.
# Both key formats are valid: older "AIzaSy..." and newer "AQ.Ab8...".
GEMINI_API_KEY=

PORT=3000

# --- Cloud sync + statistics board: OPTIONAL. ---
# The server starts without these; the Mongo-backed routes return 503 and Gemini
# is unaffected. Set them only when you want session/survey history in Atlas.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# DB_NAME=stressstrike
